 		}
@@ -166,6 +169,9 @@ func NewONNXCustomClassifier(modelPath string, opts ONNXCustomClassifierOptions)
 	}
 	var configErr error
 	builder = builder.SessionOptions(func(so *ortlib.SessionOptions) {
+		if gpuEnabled() {
+			configErr = configureGPU(so)
+		}
 		if err := so.SetIntraOpNumThreads(threads); err != nil && configErr == nil {
 			configErr = fmt.Errorf("failed to set IntraOpNumThreads to %d: %w", threads, err)
 		}
@@ -401,3 +407,47 @@ func DestroyONNXRuntime() error {
 	clearORTRuntime()
 	return nil
 }
+
+func gpuEnabled() bool {
+	return os.Getenv("BIRDNET_CUDA") == "1" || os.Getenv("BIRDNET_TENSORRT") == "1"
+}
+
+// configureGPU enables TensorRT (optional, FP32 by default) and CUDA execution providers.
+func configureGPU(so *ortlib.SessionOptions) error {
+	if os.Getenv("BIRDNET_TENSORRT") == "1" {
+		trtOpts, err := ortlib.NewTensorRTProviderOptions()
+		if err != nil {
+			return fmt.Errorf("create TensorRT options: %w", err)
+		}
+		defer trtOpts.Destroy()
+		cacheDir := os.Getenv("BIRDNET_TRT_CACHE_DIR")
+		if cacheDir == "" {
+			cacheDir = "/home/birdnet/.config/birdnet-go/trt-cache"
+		}
+		_ = os.MkdirAll(cacheDir, 0o755)
+		kv := map[string]string{
+			"trt_engine_cache_enable": "1",
+			"trt_engine_cache_path":   cacheDir,
+		}
+		if os.Getenv("BIRDNET_TRT_FP16") == "1" {
+			kv["trt_fp16_enable"] = "1"
+		}
+		if err := trtOpts.Update(kv); err != nil {
+			return fmt.Errorf("update TensorRT options: %w", err)
+		}
+		if err := so.AppendExecutionProviderTensorRT(trtOpts); err != nil {
+			return fmt.Errorf("enable TensorRT: %w", err)
+		}
+		fmt.Fprintf(os.Stderr, "BirdNET-Go: TensorRT execution provider enabled (cache=%s fp16=%s)\n", cacheDir, os.Getenv("BIRDNET_TRT_FP16"))
+	}
+	options, err := ortlib.NewCUDAProviderOptions()
+	if err != nil {
+		return fmt.Errorf("create CUDA options: %w", err)
+	}
+	defer options.Destroy()
+	if err := so.AppendExecutionProviderCUDA(options); err != nil {
+		return fmt.Errorf("enable CUDA: %w", err)
+	}
+	fmt.Fprintln(os.Stderr, "BirdNET-Go: CUDA execution provider enabled")
+	return nil
+}
