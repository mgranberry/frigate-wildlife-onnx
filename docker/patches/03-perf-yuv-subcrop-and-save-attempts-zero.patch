+def yuv_crop_to_rgb(yuv: np.ndarray, x: int, y: int, x2: int, y2: int) -> np.ndarray:
+    """Convert only the clamped even-aligned YUV420 I420 sub-region to RGB and pad edges."""
+    if x2 <= x or y2 <= y:
+        return np.zeros((max(1, y2 - y), max(1, x2 - x), 3), dtype=np.uint8)
+    img_h = yuv.shape[0] * 2 // 3
+    img_w = yuv.shape[1]
+    cx1, cy1 = max(0, x & ~1), max(0, y & ~1)
+    cx2, cy2 = min(img_w, (x2 + 1) & ~1), min(img_h, (y2 + 1) & ~1)
+    cw, ch = cx2 - cx1, cy2 - cy1
+    if cw <= 0 or ch <= 0:
+        return np.zeros((max(1, y2 - y), max(1, x2 - x), 3), dtype=np.uint8)
+    sx1, sy1 = max(0, x) - cx1, max(0, y) - cy1
+    sx2, sy2 = min(img_w, x2) - cx1, min(img_h, y2) - cy1
+    if sx2 <= sx1 or sy2 <= sy1:
+        return np.zeros((max(1, y2 - y), max(1, x2 - x), 3), dtype=np.uint8)
+    u_off, v_off = img_h, img_h + img_h // 4
+    uv_x1, uv_x2, uv_y1, uv_y2 = cx1 // 2, cx2 // 2, cy1 // 2, cy2 // 2
+    uv_w, uv_h = uv_x2 - uv_x1, uv_y2 - uv_y1
+    y_plane = yuv[cy1:cy2, cx1:cx2]
+    u_plane = yuv[u_off:v_off, :].reshape(img_h // 2, img_w // 2)[
+        uv_y1:uv_y2, uv_x1:uv_x2
+    ]
+    v_plane = yuv[v_off:, :].reshape(img_h // 2, img_w // 2)[uv_y1:uv_y2, uv_x1:uv_x2]
+    sub_i420 = np.empty((ch * 3 // 2, cw), dtype=np.uint8)
+    sub_i420[:ch, :] = y_plane
+    uv_size = uv_h * uv_w
+    flat_uv = sub_i420[ch:, :].ravel()
+    flat_uv[:uv_size] = u_plane.ravel()
+    flat_uv[uv_size : 2 * uv_size] = v_plane.ravel()
+    rgb_sub = cv2.cvtColor(sub_i420, cv2.COLOR_YUV2RGB_I420)[sy1:sy2, sx1:sx2]
+    if x < 0 or y < 0 or x2 > img_w or y2 > img_h:
+        out = np.zeros((y2 - y, x2 - x, 3), dtype=np.uint8)
+        ox, oy = max(0, -x), max(0, -y)
+        out[oy : oy + rgb_sub.shape[0], ox : ox + rgb_sub.shape[1]] = rgb_sub
+        return out
+    return rgb_sub
+
