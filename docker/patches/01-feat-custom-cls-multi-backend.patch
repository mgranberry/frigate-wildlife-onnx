+class TFLiteClassifierBackend(ClassificationBackend):
+    """TFLite / LiteRT backend supporting CPU and Coral EdgeTPU delegates."""
+
+    def __init__(
+        self, model_path: str, model_config: CustomClassificationConfig
+    ) -> None:
+        super().__init__(model_config)
+        Interpreter, load_delegate = _import_tflite()
+
+        delegates: list[Any] = []
+        dev = (model_config.device or "").strip().lower()
+        if is_edgetpu_device(dev):
+            delegate_opts = {} if dev == "edgetpu" else {"device": dev}
+            delegates = [load_delegate("libedgetpu.so.1.0", delegate_opts)]
+        elif dev and dev not in ("auto", "cpu"):
+            logger.warning(
+                "TFLite classification backend ignores device '%s' and runs on CPU",
+                model_config.device,
+            )
+
+        self.backend_name = "EdgeTPU" if delegates else "TFLite"
+        with suppress_stderr_during("tflite_interpreter_init"):
+            self.interpreter = Interpreter(
+                model_path=model_path,
+                num_threads=2,
+                experimental_delegates=delegates or None,
+            )
+            self.interpreter.allocate_tensors()
+        self.tensor_input_details = self.interpreter.get_input_details()
+        self.tensor_output_details = self.interpreter.get_output_details()
+        self._requires_int8_input = self.tensor_input_details[0].get("dtype") == np.int8
+        self._validate_input_details(model_path)
+
+    def _format_tflite_input(self, tensor_in: np.ndarray) -> np.ndarray:
+        if self._requires_int8_input and tensor_in.dtype == np.uint8:
+            return np.bitwise_xor(tensor_in, 128).view(np.int8)
+        return tensor_in
+
+    def _validate_input_details(self, model_path: str) -> None:
+        input_detail = self.tensor_input_details[0]
+        in_w, in_h = self.input_size
+        sample = self._format_tflite_input(
+            self._prepare_input(np.zeros((in_h, in_w, 3), dtype=np.uint8))
+        )
+
+        raw_shape = input_detail.get("shape")
+        if raw_shape is not None and len(raw_shape) > 0:
+            expected_shape = tuple(int(d) for d in raw_shape)
+            if len(expected_shape) != len(sample.shape) or not all(
+                e <= 0 or e == a for e, a in zip(expected_shape, sample.shape)
+            ):
+                raise ValueError(
+                    f"TFLite model {model_path} expects input shape {expected_shape}, "
+                    f"got {sample.shape} from config"
+                )
+
+        expected_dtype_raw = input_detail.get("dtype")
+        if expected_dtype_raw is not None:
+            expected_dtype = np.dtype(expected_dtype_raw)
+            if sample.dtype != expected_dtype:
+                raise ValueError(
+                    f"TFLite model {model_path} expects input dtype {expected_dtype}, "
+                    f"got {sample.dtype} from config"
+                )
+
+    def _decode_output(self, raw: np.ndarray) -> np.ndarray:
+        raw_arr = np.asarray(raw).ravel()
+        if raw_arr.size == 0:
+            return np.array([], dtype=np.float64)
+
+        output_detail = self.tensor_output_details[0]
+        quant = output_detail.get("quantization") or (0.0, 0)
+        scale, zero_point = quant
+
+        if np.issubdtype(raw_arr.dtype, np.integer):
+            if scale:
+                info = np.iinfo(raw_arr.dtype)
+                min_val = (info.min - zero_point) * scale
+                max_val = (info.max - zero_point) * scale
+                dequant = (raw_arr.astype(np.float64) - zero_point) * scale
+                if min_val >= -1e-3 and max_val <= 1.0 + 1e-2:
+                    clipped = np.maximum(dequant, 0.0)
+                    total = float(clipped.sum())
+                    return np.asarray(
+                        clipped / total if total > 0.0 else clipped,
+                        dtype=np.float64,
+                    )
+                return _to_probabilities(dequant)
+            if np.issubdtype(raw_arr.dtype, np.unsignedinteger):
+                arr = raw_arr.astype(np.float64)
+                total = float(arr.sum())
+                return np.asarray(arr / total if total > 0.0 else arr, dtype=np.float64)
+            return _to_probabilities(raw_arr)
+
+        return _to_probabilities(raw_arr)
+
+    def _infer(self, tensor_in: np.ndarray) -> np.ndarray:
+        tensor_in = self._format_tflite_input(tensor_in)
+        self.interpreter.set_tensor(self.tensor_input_details[0]["index"], tensor_in)
+        self.interpreter.invoke()
+        raw = np.asarray(
+            self.interpreter.get_tensor(self.tensor_output_details[0]["index"])
+        )
+        if raw.ndim > 1:
+            raw = raw[0]
+        return self._decode_output(raw)
+
