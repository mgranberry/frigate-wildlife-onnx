+def _crop_and_resize_object(
+    rgb: np.ndarray,
+    box: list[int] | tuple[int, int, int, int],
+    target_size: tuple[int, int],
+    strategy: CropStrategyEnum | str = CropStrategyEnum.square,
+    scale: float = 1.0,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Crop an object from an RGB frame and resize according to strategy."""
+    resolved_strategy = CropStrategyEnum(strategy)
+    img_h, img_w = rgb.shape[:2]
+    if img_h <= 0 or img_w <= 0:
+        raise ValueError("Empty input frame")
+
+    xmin, ymin, xmax, ymax = int(box[0]), int(box[1]), int(box[2]), int(box[3])
+    if resolved_strategy == CropStrategyEnum.square:
+        x, y, x2, y2 = calculate_region(
+            rgb.shape,
+            xmin,
+            ymin,
+            xmax,
+            ymax,
+            int(max(xmax - xmin, ymax - ymin) * scale),
+            1.0,
+        )
+        crop = rgb[y:y2, x:x2]
+    else:
+        cx = (xmin + xmax) / 2.0
+        cy = (ymin + ymax) / 2.0
+        half_w = (xmax - xmin) * scale / 2.0
+        half_h = (ymax - ymin) * scale / 2.0
+        x = max(0, min(img_w - 1, int(cx - half_w)))
+        y = max(0, min(img_h - 1, int(cy - half_h)))
+        x2 = min(img_w, max(x + 1, int(cx + half_w)))
+        y2 = min(img_h, max(y + 1, int(cy + half_h)))
+        crop = rgb[y:y2, x:x2]
+
+    if crop.size == 0:
+        raise ValueError("Empty crop region")
+
+    if resolved_strategy == CropStrategyEnum.letterbox:
+        tw, th = target_size
+        ch, cw = crop.shape[:2]
+        ratio = min(tw / max(1, cw), th / max(1, ch))
+        nw = max(1, int(round(cw * ratio)))
+        nh = max(1, int(round(ch * ratio)))
+        resized = cv2.resize(crop, (nw, nh))
+        canvas = np.zeros((th, tw, 3), dtype=np.uint8)
+        y_off = (th - nh) // 2
+        x_off = (tw - nw) // 2
+        canvas[y_off : y_off + nh, x_off : x_off + nw] = resized
+        return crop, canvas
+
+    return crop, resize_classification_image(crop, target_size)
+
