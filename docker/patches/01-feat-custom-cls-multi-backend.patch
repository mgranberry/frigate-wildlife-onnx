+class ONNXClassifierBackend(ClassificationBackend):
+    """ONNX Runtime backend delegating runner selection to Frigate's factory."""
+
+    def __init__(
+        self, model_path: str, model_config: CustomClassificationConfig
+    ) -> None:
+        super().__init__(model_config)
+        from frigate.detectors.detection_runners import get_optimized_runner
+
+        raw_dev = (model_config.device or "").strip()
+        upper_dev = raw_dev.upper()
+        if not raw_dev:
+            device = "AUTO"
+        elif upper_dev in ("AUTO", "CPU", "GPU", "NPU") or upper_dev.startswith(
+            ("GPU.", "CPU.")
+        ):
+            device = upper_dev
+        elif upper_dev == "TENSORRT":
+            device = "Tensorrt"
+        else:
+            device = raw_dev
+
+        self.runner = get_optimized_runner(
+            model_path,
+            device=device,
+            model_type=CUSTOM_CLASSIFICATION_MODEL_TYPE,
+        )
+        self.backend_name = self.runner.device_name
+        self.input_name = self.runner.get_input_names()[0]
+
+        in_w, in_h = self.input_size
+        self._infer(self._prepare_input(np.zeros((in_h, in_w, 3), dtype=np.uint8)))
+
+    def _infer(self, tensor_in: np.ndarray) -> np.ndarray:
+        outputs = self.runner.run({self.input_name: tensor_in})
+        if not outputs:
+            return np.array([], dtype=np.float64)
+        raw = np.asarray(outputs[0])
+        if raw.ndim > 1:
+            raw = raw[0]
+        return _to_probabilities(raw)
+
+
+def load_classification_backend(
+    model_dir: str,
+    model_config: CustomClassificationConfig,
+) -> tuple[ClassificationBackend | None, dict[int, str]]:
+    """Load the classification backend matching model_config and labelmap."""
+    labelmap_path = os.path.join(model_dir, "labelmap.txt")
+    if not os.path.exists(labelmap_path):
+        return None, {}
+
+    onnx_path = os.path.join(model_dir, "model.onnx")
+    tflite_path = os.path.join(model_dir, "model.tflite")
+
+    backend: ClassificationBackend
+    if is_edgetpu_device(model_config.device):
+        if os.path.exists(tflite_path):
+            backend = TFLiteClassifierBackend(tflite_path, model_config)
+        else:
+            if os.path.exists(onnx_path):
+                logger.error(
+                    "EdgeTPU device '%s' requires model.tflite for %s, but only model.onnx is present",
+                    model_config.device,
+                    model_config.name,
+                )
+            return None, {}
+    elif os.path.exists(onnx_path):
+        backend = ONNXClassifierBackend(onnx_path, model_config)
+    elif os.path.exists(tflite_path):
+        backend = TFLiteClassifierBackend(tflite_path, model_config)
+    else:
+        return None, {}
+
+    return backend, load_labels(labelmap_path, prefill=0, indexed=False)
