+def _to_probabilities(raw: np.ndarray) -> np.ndarray:
+    """Convert raw float scores or logits into a 1D float64 probability vector."""
+    arr = np.asarray(raw, dtype=np.float64).ravel()
+    if arr.size == 0:
+        return arr
+    total = float(arr.sum())
+    if np.all(arr >= 0.0) and total > 0.0 and abs(total - 1.0) <= 1e-2:
+        return np.asarray(arr / total, dtype=np.float64)
+    exps = np.exp(arr - np.max(arr))
+    return np.asarray(exps / exps.sum(), dtype=np.float64)
+
