+class ClassificationBackend(ABC):
+    """Runtime backend interface for custom classification models."""
+
+    backend_name: str
+    input_size: tuple[int, int]
+
+    def __init__(self, model_config: CustomClassificationConfig) -> None:
+        self.input_size = (int(model_config.width), int(model_config.height))
+        self.input_transform = tensor_transform(model_config.input_tensor)
+        self.input_pixel_format = model_config.input_pixel_format
+        self.input_dtype = model_config.input_dtype
+
+    def _prepare_input(self, resized_rgb: np.ndarray) -> np.ndarray:
+        """Format an RGB (H, W, 3) uint8 crop to match the model's declared input spec."""
+        img = (
+            cv2.cvtColor(resized_rgb, cv2.COLOR_RGB2BGR)
+            if self.input_pixel_format == ClassificationPixelFormatEnum.bgr
+            else resized_rgb
+        )
+        tensor_input: np.ndarray = np.expand_dims(img, axis=0)
+        if self.input_transform:
+            tensor_input = np.transpose(tensor_input, self.input_transform)
+        if self.input_dtype == InputDTypeEnum.float:
+            tensor_input = tensor_input.astype(np.float32) / 255.0
+        elif self.input_dtype == InputDTypeEnum.float_denorm:
+            tensor_input = tensor_input.astype(np.float32)
+        return tensor_input
+
+    def predict(self, resized_rgb: np.ndarray) -> np.ndarray:
+        """Run inference on an RGB crop sized to input_size and return 1D probabilities."""
+        return self._infer(self._prepare_input(resized_rgb))
+
+    @abstractmethod
+    def _infer(self, tensor_in: np.ndarray) -> np.ndarray:
+        """Run backend-specific inference on a formatted input tensor."""
+
